# ============================================================================
# CCTV Live-Feed Simulator — Environment Configuration
# Copy to .env and adjust for your deployment.
# ============================================================================

# --- Video Source -----------------------------------------------------------
VIDEOS_DIR=./videos
# PROCESSED_SUBDIR=processed
# HLS_SUBDIR=hls
# HLS_TIME=6

# --- Feed Timing (two 12-hour slots per day) --------------------------------
TIMEZONE=Asia/Kolkata
SLOT_START=21:00
SLOT_HOURS=12.0
# LOOP_WITHIN_VIDEO=true
# DRIFT_TOLERANCE_SECONDS=5.0

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Workers: 2×CPU cores recommended. Minimum 4 for 200+ users.
# WORKERS=4
# READ_THREADS=128

# --- RTSP live gateway (MediaMTX) ------------------------------------------
# Static files are published with ffmpeg -re as live RTSP/WebRTC/HLS.
RTSP_ENABLED=true
# RTSP_PUBLISH_URL=rtsp://127.0.0.1:8554
# Advertised host in API URLs. "auto" uses the incoming request Host header.
RTSP_PUBLIC_HOST=auto
# RTSP_PORT=8554
# WEBRTC_PORT=8889
# HLS_LIVE_ORIGIN=http://127.0.0.1:8888
# HLS_LIVE_VIA_PROXY=true
# RTSP_PATH_PREFIX=stream
# RTSP_TRANSPORT=tcp

# --- Security (recommended for internet-facing deployments) -----------------
# SHARE_USERNAME=admin
# SHARE_PASSWORD=changeme
# CORS_ALLOW_ORIGINS=*

# --- Docker Compose overrides -----------------------------------------------
# LISTEN_PORT=80
# APP_CPUS=4.0
# APP_MEM=2G
# NGINX_CPUS=2.0
# NGINX_MEM=512M

# --- FFmpeg -----------------------------------------------------------------
# FFPROBE_BIN=ffprobe
# LIBRARY_CACHE_FILE=./cache/library.json
